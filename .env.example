# Browser-safe Supabase configuration only.
# Add these to local .env.local / Vercel. Never put service-role or provider
# secrets behind VITE_ variables because Vite intentionally exposes them.
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Temporary compatibility only if an older environment still uses it:
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key
